#!/usr/bin/env bash

set -euo pipefail

gate="/tmp/cbm-code-discovery-gate-$PPID"

find /tmp -name 'cbm-code-discovery-gate-*' -mtime +1 -delete 2>/dev/null || true

if [[ -f "$gate" ]]; then
	exit 0
fi

touch "$gate"
printf '%s\n' 'BLOCKED: For code discovery, use codebase-memory-mcp tools first: search_graph(name_pattern) to find functions/classes, trace_path() for call chains, get_code_snippet(qualified_name) to read source. If the graph is not indexed yet, call index_repository first. Fall back to Grep/Glob/Read only for text content search. If you need Grep, retry.' >&2
exit 2
