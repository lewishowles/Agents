{
	"agentPushNotifEnabled": true,
	"contextCompactionThreshold": 80,
	"enabledPlugins": {},
	"env": {
		"CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
		"CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
		"MAX_THINKING_TOKENS": "10000"
	},
	"hooks": {
		"PostToolUse": [
			{
				"hooks": [
					{
						"command": "bash -c 'bash \"$HOME/.claude/hooks/plan-verify.sh\"'",
						"timeout": 5,
						"type": "command"
					}
				],
				"matcher": "ExitPlanMode"
			},
			{
				"hooks": [
					{
						"command": "bash -c 'bash \"$HOME/.claude/hooks/auto-format.sh\"'",
						"timeout": 10,
						"type": "command"
					}
				],
				"matcher": "Edit|Write"
			}
		],
		"PreToolUse": [
			{
				"hooks": [
					{
						"command": "jq -r '.tool_input.file_path // empty' | { read fp; if echo \"$fp\" | grep -q '\\.env'; then exit 2; fi; }",
						"type": "command"
					}
				],
				"matcher": "Read"
			},
			{
				"hooks": [
					{
						"command": "bash -c 'bash \"$HOME/.claude/hooks/skill-file-trigger.sh\"'",
						"timeout": 5,
						"type": "command"
					},
					{
						"command": "bash -c 'bash \"$HOME/.claude/hooks/test-skeleton-reminder.sh\"'",
						"timeout": 5,
						"type": "command"
					},
					{
						"command": "bash \"/Users/lewis/.claude/hooks/auto-allow-edits.sh\"",
						"timeout": 5,
						"type": "command"
					}
				],
				"matcher": "Write|Edit"
			},
			{
				"hooks": [
					{
						"command": "/opt/homebrew/bin/tokensave hook-pre-tool-use",
						"type": "command"
					}
				],
				"matcher": "Agent"
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"command": "bash -c 'bash \"$HOME/.claude/hooks/pre-stop-checks.sh\"'",
						"statusMessage": "Checking lint and tests…",
						"timeout": 60,
						"type": "command"
					}
				]
			},
			{
				"hooks": [
					{
						"command": "/opt/homebrew/bin/tokensave hook-stop",
						"type": "command"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"command": "bash -c 'bash \"$HOME/.claude/hooks/skill-autotrigger.sh\"'",
						"timeout": 5,
						"type": "command"
					},
					{
						"command": "bash -c 'bash \"$HOME/.claude/hooks/progress-resume.sh\"'",
						"timeout": 5,
						"type": "command"
					}
				]
			},
			{
				"hooks": [
					{
						"command": "/opt/homebrew/bin/tokensave hook-prompt-submit",
						"type": "command"
					}
				]
			}
		]
	},
	"modelCaching": true,
	"permissions": {
		"allow": [
			"mcp__tokensave__tokensave_affected",
			"mcp__tokensave__tokensave_ast_grep_rewrite",
			"mcp__tokensave__tokensave_body",
			"mcp__tokensave__tokensave_branch_diff",
			"mcp__tokensave__tokensave_branch_list",
			"mcp__tokensave__tokensave_branch_search",
			"mcp__tokensave__tokensave_by_qualified_name",
			"mcp__tokensave__tokensave_callees",
			"mcp__tokensave__tokensave_callers",
			"mcp__tokensave__tokensave_callers_for",
			"mcp__tokensave__tokensave_changelog",
			"mcp__tokensave__tokensave_circular",
			"mcp__tokensave__tokensave_commit_context",
			"mcp__tokensave__tokensave_complexity",
			"mcp__tokensave__tokensave_config",
			"mcp__tokensave__tokensave_constructors",
			"mcp__tokensave__tokensave_context",
			"mcp__tokensave__tokensave_coupling",
			"mcp__tokensave__tokensave_dead_code",
			"mcp__tokensave__tokensave_dependency_depth",
			"mcp__tokensave__tokensave_derives",
			"mcp__tokensave__tokensave_diagnose",
			"mcp__tokensave__tokensave_diagnostics",
			"mcp__tokensave__tokensave_diff_context",
			"mcp__tokensave__tokensave_distribution",
			"mcp__tokensave__tokensave_doc_coverage",
			"mcp__tokensave__tokensave_dsm",
			"mcp__tokensave__tokensave_field_sites",
			"mcp__tokensave__tokensave_files",
			"mcp__tokensave__tokensave_gini",
			"mcp__tokensave__tokensave_god_class",
			"mcp__tokensave__tokensave_health",
			"mcp__tokensave__tokensave_hotspots",
			"mcp__tokensave__tokensave_impact",
			"mcp__tokensave__tokensave_implementations",
			"mcp__tokensave__tokensave_impls",
			"mcp__tokensave__tokensave_inheritance_depth",
			"mcp__tokensave__tokensave_insert_at",
			"mcp__tokensave__tokensave_largest",
			"mcp__tokensave__tokensave_module_api",
			"mcp__tokensave__tokensave_multi_str_replace",
			"mcp__tokensave__tokensave_node",
