			"mcp__tokensave__tokensave_port_order",
			"mcp__tokensave__tokensave_port_status",
			"mcp__tokensave__tokensave_pr_context",
			"mcp__tokensave__tokensave_rank",
			"mcp__tokensave__tokensave_read",
			"mcp__tokensave__tokensave_record_code_area",
			"mcp__tokensave__tokensave_record_decision",
			"mcp__tokensave__tokensave_recursion",
			"mcp__tokensave__tokensave_rename_preview",
			"mcp__tokensave__tokensave_run_affected_tests",
			"mcp__tokensave__tokensave_search",
			"mcp__tokensave__tokensave_session_end",
			"mcp__tokensave__tokensave_session_recall",
			"mcp__tokensave__tokensave_session_start",
			"mcp__tokensave__tokensave_signature",
			"mcp__tokensave__tokensave_signature_search",
			"mcp__tokensave__tokensave_similar",
			"mcp__tokensave__tokensave_simplify_scan",
			"mcp__tokensave__tokensave_status",
			"mcp__tokensave__tokensave_str_replace",
			"mcp__tokensave__tokensave_test_map",
			"mcp__tokensave__tokensave_test_risk",
			"mcp__tokensave__tokensave_todos",
			"mcp__tokensave__tokensave_type_hierarchy",
			"mcp__tokensave__tokensave_unsafe_patterns",
			"mcp__tokensave__tokensave_unused_imports"
		]
	},
	"promptCaching": true,
	"skillOverrides": {
		"accessibility": "name-only",
		"agentic-engineering": "name-only",
		"architecture-decision-records": "name-only",
		"bash": "name-only",
		"claude-api": "name-only",
		"code-style": "on",
		"dependencies": "name-only",
		"e2e-testing": "name-only",
		"error-handling": "on",
		"fewer-permission-prompts": "name-only",
		"init": "name-only",
		"keybindings-help": "name-only",
		"loop": "name-only",
		"readme": "name-only",
		"review": "name-only",
