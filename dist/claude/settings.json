{
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "MAX_THINKING_TOKENS": "10000"
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'input=$(cat); cwd=$(echo \"$input\" | jq -r \".workspace.current_dir // empty\"); dir=$(basename \"$cwd\" 2>/dev/null); tokens=$(echo \"$input\" | jq -r \".context_window.total_input_tokens // empty\"); model=$(echo \"$input\" | jq -r \".model.display_name // empty\"); effort=$(echo \"$input\" | jq -r \".effort.level // empty\"); five=$(echo \"$input\" | jq -r \".rate_limits.five_hour.used_percentage // empty\"); seven=$(echo \"$input\" | jq -r \".rate_limits.seven_day.used_percentage // empty\"); green=$(printf \"\\\\033[38;5;114m\"); orange=$(printf \"\\\\033[38;5;215m\"); pink=$(printf \"\\\\033[38;5;211m\"); white=$(printf \"\\\\033[1;97m\"); grey=$(printf \"\\\\033[38;5;240m\"); reset=$(printf \"\\\\033[0m\"); sep=\" ${grey}\u00b7${reset} \"; tokensfmt=\"\"; if [[ -n \"$tokens\" ]]; then if (( tokens >= 1000000 )); then tokensfmt=$(echo \"scale=1; $tokens / 1000000\" | bc)M; elif (( tokens >= 1000 )); then tokensfmt=$(echo \"scale=1; $tokens / 1000\" | bc)K; else tokensfmt=\"${tokens}\"; fi; fi; fiveleft=\"\"; [[ -n \"$five\" ]] && fiveleft=$(printf \"%.0f\" \"$(echo \"100 - $five\" | bc)\"); sevenleft=\"\"; [[ -n \"$seven\" ]] && sevenleft=$(printf \"%.0f\" \"$(echo \"100 - $seven\" | bc)\"); parts=(); [[ -n \"$dir\" ]] && parts+=(\"${green}${dir}${reset}\"); [[ -n \"$tokensfmt\" ]] && parts+=(\"${orange}${tokensfmt} used${reset}\"); [[ -n \"$fiveleft\" ]] && parts+=(\"${pink}5h ${fiveleft}% left${reset}\"); [[ -n \"$sevenleft\" ]] && parts+=(\"${pink}weekly ${sevenleft}% left${reset}\"); if [[ -n \"$model\" ]]; then m=\"$model\"; [[ -n \"$effort\" ]] && m=\"$m $effort\"; parts+=(\"${white}${m}${reset}\"); fi; out=\"\"; for p in \"${parts[@]}\"; do if [[ -z \"$out\" ]]; then out=\"$p\"; else out=\"$out$sep$p\"; fi; done; printf \"%s\\\\n\" \"$out\"'"
  },
  "permissions": {
    "allow": [
      "mcp__codebase-memory-mcp__delete_project",
      "mcp__codebase-memory-mcp__detect_changes",
      "mcp__codebase-memory-mcp__get_architecture",
      "mcp__codebase-memory-mcp__get_code_snippet",
      "mcp__codebase-memory-mcp__get_graph_schema",
      "mcp__codebase-memory-mcp__index_repository",
      "mcp__codebase-memory-mcp__index_status",
      "mcp__codebase-memory-mcp__ingest_traces",
      "mcp__codebase-memory-mcp__list_projects",
      "mcp__codebase-memory-mcp__manage_adr",
      "mcp__codebase-memory-mcp__query_graph",
      "mcp__codebase-memory-mcp__search_code",
      "mcp__codebase-memory-mcp__search_graph",
      "mcp__codebase-memory-mcp__trace_path"
    ]
  },
  "skillOverrides": {
    "accessibility": "name-only",
    "bash": "name-only",
    "project-compact-progress": "name-only",
    "project-continue": "name-only",
    "claude-api": "name-only",
    "code-style": "on",
    "dependencies": "name-only",
    "test-e2e": "name-only",
    "error-handling": "on",
    "fewer-permission-prompts": "name-only",
    "init": "name-only",
    "keybindings-help": "name-only",
    "loop": "name-only",
    "project-plan-task": "name-only",
    "writing-readme": "name-only",
    "review": "name-only",
    "schedule": "name-only",
    "security-review": "name-only",
    "project-setup": "name-only",
    "simplify": "name-only",
    "swift": "name-only",
    "swift-ui": "name-only",
    "typescript": "name-only",
    "writing-copy": "name-only",
    "test-unit": "name-only",
    "update-config": "name-only",
    "vue-vite": "name-only",
    "vue": "name-only",
    "vue-project-stack": "name-only",
    "writing": "on"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read fp; if echo \"$fp\" | grep -q '\\.env'; then exit 2; fi; }"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/serena-remind.sh\"'"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/skill-file-trigger.sh\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/test-skeleton-reminder.sh\"'"
          }
        ]
      },
      {
        "matcher": "mcp__serena__*",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks auto-approve --client=claude-code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/auto-format.sh\"'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/plan-verify.sh\"'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks cleanup --client=claude-code"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks activate --client=claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/pre-stop-checks.sh\"'",
            "timeout": 60,
            "statusMessage": "Checking lint and tests\u2026"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/progress-resume.sh\"'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disabledMcpjsonServers": [
    "mdn"
  ],
  "enabledPlugins": {},
  "agentPushNotifEnabled": true,
  "contextCompactionThreshold": 80,
  "modelCaching": true,
  "promptCaching": true
}
